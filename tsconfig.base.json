{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // --- Mandatory: module safety ---
    // Every file must compile in isolation, as tsdown, Vite and Bun process them that way.
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only syntax that can be stripped is allowed. This forbids `enum`, `namespace` and
    // constructor parameter properties, so those rules are enforced by the compiler.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // --- Mandatory: strictness ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // --- Project-dependent ---
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}

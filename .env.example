# Server port. Pick a free one (`ss -ltn`); the tunnel and Vite's proxy point at it.
PORT=39422
PUBLIC_URL=https://lyra.jzszdznzzl.dev
DATA_DIR=.data
# false: nobody can create new accounts (the sign-up page disappears).
REGISTRATION_ENABLED=true
# 32 random bytes in base64: `openssl rand -base64 32`. Losing it unlinks every Google account.
SECRET_KEY=

# Optional: a system Chrome/Chromium for the Google sign-in browser, e.g. /usr/bin/google-chrome.
# BROWSER_EXECUTABLE=

# Optional: a Lyra user whose linked Google account (use a dedicated one) plays songs for users
# who did not link theirs. Needed where YouTube blocks anonymous requests, like on a VPS.
# STREAM_FALLBACK_USERNAME=

# smtp, log (prints mails to the console) or file (writes them to DATA_DIR/outbox).
MAIL_TRANSPORT=smtp
MAIL_FROM=Lyra <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
# Quote values that contain # or $ ('like#this'); unquoted, Bun reads # as a comment.
SMTP_PASS=

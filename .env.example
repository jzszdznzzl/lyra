# Server port. Pick a free one (`ss -ltn`); the tunnel and Vite's proxy point at it.
PORT=39422
PUBLIC_URL=https://lyra.jzszdznzzl.dev
DATA_DIR=.data
# 32 random bytes in base64: `openssl rand -base64 32`. Losing it unlinks every Google account.
SECRET_KEY=

# smtp, log (prints mails to the console) or file (writes them to DATA_DIR/outbox).
MAIL_TRANSPORT=smtp

{
  "name": "lyra",
  "version": "0.1.0",
  "private": true,
  "description": "Personal music player on top of YT Music, with cross-device playback control",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "bun": ">=1.4",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "deploy:local": "pnpm build && systemctl --user restart lyra.service"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
